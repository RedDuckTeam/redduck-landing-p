# HTML is always revalidated: a stale doc references content-hashed asset URLs a
# newer deploy has already replaced (dead chunks). NOTE: when multiple rules
# match, Cloudflare MERGES same-name headers (comma-joined) — it does NOT pick
# the most specific rule. The asset rules below therefore detach this header
# first (`! Cache-Control`) before setting their own.
/*
  Cache-Control: no-cache

# Unhashed static images: cache for a day instead of revalidating on every
# request. Stale-for-a-day is acceptable; rename the file to bust the cache.
/images/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
/svg/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Content-hashed assets are safe to cache forever (the hash changes with content).
/_build/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/_build/.vite/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
